# Copy to .env (untracked) and fill in. Secrets MUST stay out of version control.
# In cloud, these come from GCP Secret Manager, not a committed file.

# --- Reads (public metadata) ---
YOUTUBE_API_KEY=
# Apple Podcasts read uses the public iTunes lookup API - no key, secret, or token needed.

# --- Write (real mode only; our own throwaway test channel) ---
YOUTUBE_OAUTH_CLIENT_SECRETS=./secrets/oauth_client.json
YOUTUBE_OAUTH_TOKEN=./secrets/youtube_token.json
TEST_CHANNEL_ID=
TEST_VIDEO_ID=

# --- The one chosen show, present on both platforms ---
TARGET_YOUTUBE_SOURCE=
# Apple Podcasts "collectionId": the number in the show's apple podcasts URL (.../id1291423644).
TARGET_APPLE_SHOW=

# --- Storage ---
# Default backend is JSON (hermetic, no services). Set DATABASE_URL to use Postgres+pgvector.
DATABASE_URL=
# e.g. postgresql+psycopg://ontology:ontology@localhost:5432/ontology
REDIS_URL=redis://localhost:6379/0

# --- Embeddings (provider behind a port) ---
# EMBEDDING_PROVIDER: voyage (hosted, default in cloud) or local (sentence-transformers, offline/CI).
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# --- AI (agent + LLM-as-judge evals) ---
ANTHROPIC_API_KEY=

# --- Tracing / observability (Langfuse) ---
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Run output directory (JSON backend + audit log) ---
RUN_DIR=./run
